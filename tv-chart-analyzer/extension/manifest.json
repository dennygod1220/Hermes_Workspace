{
  "manifest_version": 3,
  "name": "TradingView Chart Analyzer",
  "version": "1.0.0",
  "description": "Capture TradingView chart screenshots + market data for Hermes Agent analysis",
  "permissions": ["activeTab", "tabs", "downloads", "storage", "scripting"],
  "host_permissions": ["https://www.tradingview.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["https://www.tradingview.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
